          "window_drag": true,
          "content": {
            "mod": "one-piece",
            "props": {
              "region": "brand"
            }
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
