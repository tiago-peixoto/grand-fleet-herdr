{
  "id": "root",
  "type": "row",
  "background": "#101f25",
  "gap": 1,
  "children": [
    {
      "id": "fleet",
      "type": "block",
      "size": {
        "px": 310
      },
      "min": 270,
      "max": 420,
      "content": {
        "mod": "one-piece"
      }
    },
    {
      "id": "workspace",
      "type": "column",
      "children": [
        {
          "id": "fleet-header",
          "type": "block",
          "size": {
            "px": 58
          },
          "content": {
            "mod": "one-piece",
            "props": {
              "view": "header"
            }
          }
        },
        {
          "id": "fleet-tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "terminals",
              "type": "block",
              "padding": 10,
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 9,
                  "background": "#13262c",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#314b50"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#e8bd70"
                  },
                  "header": {
                    "content": {
                      "mod": "one-piece",
                      "props": {
                        "view": "pane"
                      }
                    },
                    "height": 40,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
